{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/com.bookreader.app/book_content/**" },
        { "path": "$APPDATA/com.bookreader.app/book_content" },
        { "path": "$APPDATA/com.bookreader.app/documents/**" },
        { "path": "$APPDATA/com.bookreader.app/documents" }
      ]
    }
  ]
}
